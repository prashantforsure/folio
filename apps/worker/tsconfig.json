{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // web's lib and jsx: the worker typechecks web's source through `web/worker`,
    // and tsc follows type-only imports into modules the bundle never loads.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
